# --------------------------------------------------------------------------
# 5. Alineamiento multiple: los seis fragmentos juntos
# --------------------------------------------------------------------------
# Un alineamiento multiple enfrenta todas las secuencias a la vez, en
# columnas. Cada columna es una posicion homologa: las bases de esa
# columna descienden de la misma base del ancestro comun. Estos seis
# fragmentos cubren la misma region del gen 18S, tienen la misma
# longitud y en esta ventana no hay inserciones ni deleciones, asi que
# apilarlos tal cual ya es un alineamiento multiple valido: cada columna
# enfrenta posiciones homologas sin necesidad de gaps. Con secuencias de
# distinta longitud o con indels habria que usar un programa de
# alineamiento multiple (por ejemplo ClustalW o MUSCLE, del paquete msa),
# que alinea primero los pares mas parecidos y luego suma el resto.
alineamiento <- fragmentos
nchar(alineamiento)

# La matriz de caracteres: una fila por especie y una columna por
# posicion del alineamiento. Todo lo que sigue se calcula de esta
# matriz, no de valores escritos a mano.
matriz_caracteres <- as.matrix(alineamiento)
n_posiciones <- ncol(matriz_caracteres)

# Consenso: en cada posicion, la base mayoritaria, es decir, la base que
# llevan mas especies en esa columna. El consenso resume el alineamiento
# en una sola secuencia: donde las seis especies coinciden, el consenso
# lleva esa base; donde difieren, lleva la base del grupo mayoritario.
base_mayoritaria <- apply(matriz_caracteres, 2, function(columna) {
  nombres_tabla <- names(which.max(table(columna)))
  nombres_tabla[1]
})
consenso <- paste(base_mayoritaria, collapse = "")
consenso

# Posiciones variables: columnas donde no todas las especies tienen la
# misma base. Son las posiciones que distinguen a las especies y las que
# llevan la senal para el arbol.
bases_distintas <- apply(matriz_caracteres, 2, function(columna) length(unique(columna)))
n_variables <- sum(bases_distintas > 1)
n_variables
n_tres_o_mas <- sum(bases_distintas >= 3)
n_tres_o_mas

# Conservacion por posicion: en cada columna, el porcentaje de especies
# que llevan la base mayoritaria. 100% es una posicion conservada, donde
# las seis especies coinciden; menos de 100% es una posicion variable.
conservacion <- vapply(seq_len(n_posiciones), function(j) {
  mean(matriz_caracteres[, j] == base_mayoritaria[j]) * 100
}, numeric(1))
tabla_conservacion <- tibble(
  posicion = seq_len(n_posiciones),
  bases_distintas = bases_distintas,
  conservacion_pct = conservacion
)
tabla_conservacion

# --------------------------------------------------------------------------
# 6. Identidad por pares desde el alineamiento multiple
# --------------------------------------------------------------------------
# La identidad entre dos especies es el porcentaje de columnas del
# alineamiento donde las dos tienen la misma base. Se calcula de la
# matriz de caracteres, posicion por posicion.
especies <- names(alineamiento)
n_especies <- length(especies)
matriz_identidad <- matrix(0, nrow = n_especies, ncol = n_especies,
  dimnames = list(especies, especies))
for (i in seq_len(n_especies)) {
  for (j in seq_len(n_especies)) {
    matriz_identidad[i, j] <- mean(matriz_caracteres[i, ] == matriz_caracteres[j, ]) * 100
  }
}
matriz_identidad

# --------------------------------------------------------------------------
# 7. Del alineamiento al arbol: distancias y neighbor-joining
# --------------------------------------------------------------------------
# Distancia p: diferencias divididas por la longitud del alineamiento.
# Es la proporcion de sitios que difieren, un numero sin unidades
# entre 0 y 1.
matriz_p <- (100 - matriz_identidad) / 100
diag(matriz_p) <- 0

# Correccion de Jukes y Cantor (Jukes y Cantor, 1969):
#   d = -3/4 * ln(1 - 4p/3)
# Cuando dos secuencias difieren en una posicion, ese sitio pudo cambiar
# mas de una vez en su historia. La distancia p cuenta solo lo que se ve
# y se queda corta; la correccion estima la distancia real, en
# sustituciones por sitio (sin unidades).
matriz_jc <- -0.75 * log(1 - 4 * matriz_p / 3)
diag(matriz_jc) <- 0
matriz_jc

# Neighbor-joining (Saitou y Nei, 1987): en cada paso se unen las dos
# especies mas cercanas segun la matriz de distancias, se crea un nodo
# interno que las agrupa y se recalculan las distancias del nuevo nodo
# al resto. La longitud de cada rama se mide en sustituciones por
# sitio. El algoritmo se escribe aqui en R, sin paquetes extra: la
# funcion recibe la matriz de distancias y devuelve la tabla de ramas,
# sus longitudes, las especies y el numero de nodos internos.
neighbor_joining <- function(D) {
  taxa <- colnames(D)
  n <- length(taxa)
  ramas <- matrix(nrow = 0, ncol = 2)
  longitudes <- numeric(0)
  activo <- taxa
  nodo <- setNames(seq_len(n), taxa)
  siguiente <- n + 1
  d <- D
  while (length(activo) > 3) {
    m <- length(activo)
    sumas <- rowSums(d)
    Q <- matrix(Inf, m, m)
    for (i in seq_len(m)) for (j in seq_len(m))
      if (i != j) Q[i, j] <- (m - 2) * d[i, j] - sumas[i] - sumas[j]
    ij <- which(Q == min(Q), arr.ind = TRUE)[1, ]
    i <- ij[1]
    j <- ij[2]
    # Longitudes de las dos ramas nuevas. Si el calculo da un valor
    # negativo (pasa cuando dos secuencias son identicas y la distancia
    # es cero), la rama se pone en 0: una longitud negativa no tiene
    # sentido biologico.
    longitud_i <- 0.5 * d[i, j] + (sumas[i] - sumas[j]) / (2 * (m - 2))
    longitud_j <- d[i, j] - longitud_i
    u <- siguiente
    siguiente <- siguiente + 1
    ramas <- rbind(ramas, c(u, nodo[[activo[i]]]), c(u, nodo[[activo[j]]]))
    longitudes <- c(longitudes, max(0, longitud_i), max(0, longitud_j))
    nuevo <- 0.5 * (d[i, ] + d[j, ] - d[i, j])
    resto <- setdiff(seq_len(m), c(i, j))
    d2 <- d[resto, resto, drop = FALSE]
    d2 <- rbind(cbind(d2, nuevo[resto]), c(nuevo[resto], 0))
    colnames(d2) <- rownames(d2) <- c(activo[resto], paste0("N", u))
    d <- d2
    nodo <- c(nodo[resto], setNames(u, paste0("N", u)))
    activo <- c(activo[resto], paste0("N", u))
  }
  # Quedan tres nodos: se unen en un nodo central, con las longitudes
  # que reparten las tres distancias entre ellos.
  raiz <- siguiente
  dab <- d[1, 2]
  dac <- d[1, 3]
  dbc <- d[2, 3]
  la <- max(0, (dab + dac - dbc) / 2)
  lb <- max(0, (dab + dbc - dac) / 2)
  lc <- max(0, (dac + dbc - dab) / 2)
  ramas <- rbind(ramas,
    c(raiz, nodo[[activo[1]]]),
    c(raiz, nodo[[activo[2]]]),
    c(raiz, nodo[[activo[3]]]))
  longitudes <- c(longitudes, la, lb, lc)
  list(edge = ramas, edge.length = longitudes, tip.label = taxa, Nnode = siguiente - n)
}

arbol <- neighbor_joining(matriz_jc)
arbol

# Texto Newick del arbol, con las longitudes de rama.
hijos_arbol <- split(arbol$edge[, 2], arbol$edge[, 1])
longitud_rama <- function(padre, hijo) {
  fila <- which(arbol$edge[, 1] == padre & arbol$edge[, 2] == hijo)
  arbol$edge.length[fila]
}
a_newick <- function(nodo) {
  hijos_nodo <- hijos_arbol[[as.character(nodo)]]
  if (is.null(hijos_nodo)) return(arbol$tip.label[nodo])
  partes <- vapply(hijos_nodo, function(h) {
    paste0(a_newick(h), ":", sprintf("%.4f", longitud_rama(nodo, h)))
  }, character(1))
  paste0("(", paste(partes, collapse = ","), ")")
}
raiz_arbol <- setdiff(unique(arbol$edge[, 1]), unique(arbol$edge[, 2]))[1]
cat(a_newick(raiz_arbol), ";\n", sep = "")

# --------------------------------------------------------------------------
# 8. Coordenadas del arbol para graficarlo con ggplot2
# --------------------------------------------------------------------------
# La raiz del dibujo es el nodo interno que nunca aparece como hijo en la
# tabla de ramas (arbol$edge). La coordenada x de cada nodo es su distancia
# a la raiz, sumando la longitud de las ramas. La coordenada y de cada punta
# se asigna recorriendo el arbol desde la raiz; la y de cada nodo interno
# es el promedio de las y de sus hijos.
n_puntas <- length(arbol$tip.label)
n_total <- n_puntas + arbol$Nnode
nodos_padre <- arbol$edge[, 1]
nodos_hijo <- arbol$edge[, 2]
raiz <- setdiff(unique(nodos_padre), unique(nodos_hijo))[1]

profundidad <- rep(NA_real_, n_total)
profundidad[raiz] <- 0
cambio <- TRUE
while (cambio) {
  cambio <- FALSE
  for (k in seq_len(nrow(arbol$edge))) {
    padre <- arbol$edge[k, 1]
    hijo <- arbol$edge[k, 2]
    if (!is.na(profundidad[padre]) && is.na(profundidad[hijo])) {
      profundidad[hijo] <- profundidad[padre] + arbol$edge.length[k]
      cambio <- TRUE
    }
  }
}

hijos_de <- split(arbol$edge[, 2], arbol$edge[, 1])

orden_puntas <- c()
recorrer <- function(nodo) {
  hijos_nodo <- hijos_de[[as.character(nodo)]]
  if (is.null(hijos_nodo)) {
    orden_puntas <<- c(orden_puntas, nodo)
  } else {
    for (h in hijos_nodo) recorrer(h)
  }
}
recorrer(raiz)

pos_y <- rep(NA_real_, n_total)
for (i in seq_along(orden_puntas)) pos_y[orden_puntas[i]] <- i
calcular_y <- function(nodo) {
  if (!is.na(pos_y[nodo])) return(pos_y[nodo])
  hijos_nodo <- hijos_de[[as.character(nodo)]]
  pos_y[nodo] <<- mean(vapply(hijos_nodo, calcular_y, numeric(1)))
  pos_y[nodo]
}
calcular_y(raiz)

# Un segmento horizontal por rama y uno vertical por nodo interno.
segmentos_h <- tibble(
  x0 = profundidad[arbol$edge[, 1]],
  x1 = profundidad[arbol$edge[, 2]],
  y = pos_y[arbol$edge[, 2]]
)
segmentos_v <- tibble(
  x = profundidad[as.integer(names(hijos_de))],
  y0 = vapply(hijos_de, function(h) min(pos_y[h]), numeric(1)),
  y1 = vapply(hijos_de, function(h) max(pos_y[h]), numeric(1))
)
etiquetas <- tibble(
  x = profundidad[seq_len(n_puntas)],
  y = pos_y[seq_len(n_puntas)],
  especie = arbol$tip.label
)

