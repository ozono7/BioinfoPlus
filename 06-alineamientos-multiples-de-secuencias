# --------------------------------------------------------------------------
# 3. Alineamiento por pares: los fragmentos de 200 nucleotidos
# --------------------------------------------------------------------------
# El alineamiento global de Needleman y Wunsch (Needleman y Wunsch, 1970)
# compara dos secuencias completas, de principio a fin. Cada columna del
# alineamiento enfrenta dos bases o una base con un gap. La puntuacion
# suma +2 por cada coincidencia y -3 por cada desajuste (matriz de
# sustitucion), y resta 5 por cada gap que se abre y 2 por cada posicion
# que lo extiende. El algoritmo busca el alineamiento con la puntuacion
# mas alta: eso es alinear, elegir el arreglo que explica mejor la
# relacion entre las dos secuencias.
matriz_sustitucion <- nucleotideSubstitutionMatrix(match = 2, mismatch = -3, baseOnly = TRUE)

al_cv_cr <- pairwiseAlignment(fragmentos[["Chlorella vulgaris"]],
  fragmentos[["Chlamydomonas reinhardtii"]], type = "global",
  substitutionMatrix = matriz_sustitucion, gapOpening = 5, gapExtension = 2)
al_cv_cr

# La puntuacion, la identidad y la longitud salen del alineamiento mismo.
# La identidad es el porcentaje de columnas con la misma base en las dos
# secuencias. Los gaps se cuentan en cada secuencia alineada: un guion
# es una posicion donde esa secuencia no tiene base.
resumen_alineamiento <- function(al) {
  patron <- as.character(pattern(al))
  sujeto <- as.character(subject(al))
  bases_patron <- strsplit(patron, split = "", fixed = TRUE)[[1]]
  bases_sujeto <- strsplit(sujeto, split = "", fixed = TRUE)[[1]]
  tibble(
    puntuacion = score(al),
    identidad_pct = pid(al),
    longitud = nchar(patron),
    coincidencias = sum(bases_patron == bases_sujeto),
    desajustes = sum(bases_patron != bases_sujeto & bases_patron != "-" & bases_sujeto != "-"),
    gaps_patron = sum(bases_patron == "-"),
    gaps_sujeto = sum(bases_sujeto == "-")
  )
}
resumen_alineamiento(al_cv_cr)

# Las dos Chlorella tienen el fragmento identico: el alineamiento es
