library(tidyverse)
library(Biostrings)

# --------------------------------------------------------------------------
# 2. Datos: secuencias del fragmento 18S (200 nucleótidos cada una)
# --------------------------------------------------------------------------
# El motivo CCTGCGGCTTAATTTGACTCAACACGGG marca el inicio del fragmento en
# las seis secuencias. Las seis cubren la misma región homóloga del gen 18S.
fragmento_aislado <- paste0(
  "CCTGCGGCTTAATTTGACTCAACACGGGAAAACTTACCAGGTCCAGACAT",
  "AGTGAGGATTGACAGATTGAGAGCTCTTTCTTGATTCTATGGGTGGTGGT",
  "GCATGGCCGTTCTTAGTTGGTGGGTTGCCTTGTCAGGTTGATTCCGGTAA",
  "CGAACGAGACCTCAGCCTGCTAAATAGTCACGGTTGGTTCGCCAGCCGGC"
)

referencias <- c(
  "Chlorella vulgaris" = paste0(
    "CCTGCGGCTTAATTTGACTCAACACGGGAAAACTTACCAGGTCCAGACAT",
    "AGTGAGGATTGACAGATTGAGAGCTCTTTCTTGATTCTATGGGTGGTGGT",
    "GCATGGCCGTTCTTAGTTGGTGGGTTGCCTTGTCAGGTTGATTCCGGTAA",
    "CGAACGAGACCTCAGCCTGCTAAATAGTCACGGTTGGTTCGCCAGCCGGC"
  ),
  "Scenedesmus acutus" = paste0(
    "CCTGCGGCTTAATTTGACTCAACACGGGAAAACTTACCAGGTCCAGACAT",
    "AGTGAGGATTGACAGATTGAGAGCTCTTTCTTGATTCTATGGGTGGTGGT",
    "GCATGGCCGTTCTTAGTTGGTGGGTTGCCTTGTCAGGTTGATTCCGGTAA",
    "CGAACGAGACCTCAGCCTGCTAAATAGTCTCAGTTGCTTTTTGCAGCTGG"
  ),
  "Dunaliella salina" = paste0(
    "CCTGCGGCTTAATTTGACTCAACACGGGAAAACTTACCAGGTCCAGACAC",
    "GGGGAGGATTGACAGATTGAGAGCTCTTTCTTGATTCTGTGGGTGGTGGT",
    "GCATGGCCGTTCTTAGTTGGTGGGTTGCCTTGTCAGGTTGATTCCGGTAA",
    "CGAACGAGACCTCAGCCTGCTAAATAGTCACGTCTACCTCGGTAGGCGCC"
  ),
  "Chlamydomonas reinhardtii" = paste0(
    "CCTGCGGCTTAATTTGACTCAACACGGGGAAACTTACCAGGTCCAGACAC",
    "GGGAAGGATTGACAGATTGAGAGCTCTTTCTTGATTCTGTGGGTGGTGGT",
    "GCATGGCCGTTCTTAGTTGGTGGGTTGCCTTGTCAGGTTGATTCCGGTAA",
    "CGAACGAGACCTCAGCCTGCTAAATAGTCAGCATCGCACCTGCGGTGCGC"
  ),
  "Haematococcus pluvialis" = paste0(
    "CCTGCGGCTTAATTTGACTCAACACGGGAAAACTTACCAGGTCCAGACAC",
    "GGGAAGGATTGACAGATTGAGAGCTCTTTCTTGATTCTGTGGGTGGTGGT",
    "GCATGGCCGTTCTTAGTTGGTGGGTTGCCTTGTCAGGTTGATTCCGGTAA",
    "CGAACGAGACCTCAGCCTGCTAAATAGTCAAGCGTACCTTGGTACGGGCT"
  )
)
