  "CTTCTTTTTTTTTTTTAGAAAAAAAAAGATCAAAAAGAAAGGCTTCTTTT",
  "CTTTTTCTCAAAAAAAAGAAAAGACTTCTATTTTTTGATTCAATGAGTTT",
  "TTCGTTCCTTAAAAAAAAAATGGAATCAGAAAAGAAAGACATGAAAAAAA",
