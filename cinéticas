# --- GRÁFICO 3: AJUSTE A MODELO DE GOMPERTZ ---
gompertz_ln_model <- function(t, A_ln, mu_max_ln, lambda_ln) { A_ln * exp(-exp(((mu_max_ln * exp(1)) / A_ln) * (lambda_ln - t) + 1)) }
datos_fit <- datos_procesados %>%
  select(dia, ln_N_N0) %>%
  filter(is.finite(ln_N_N0)) %>%
  add_row(dia = 0, ln_N_N0 = 0, .before = 1) %>%
  distinct()
fit_gompertz <- tryCatch({ nls_multstart(ln_N_N0 ~ gompertz_ln_model(dia, A_ln, mu_max_ln, lambda_ln), data = datos_fit, iter = 500, start_lower = c(A_ln = 0, mu_max_ln = 0, lambda_ln = 0), start_upper = c(A_ln = max(datos_fit$ln_N_N0, na.rm=T) * 1.5, mu_max_ln = 5, lambda_ln = max(datos_fit$dia)/2), supp_errors = 'Y') }, error = function(e) NULL)
predicted_curve <- data.frame(dia = seq(0, max(datos_procesados$dia, na.rm=T), length.out = 100))
if (!is.null(fit_gompertz)) { predicted_curve$ln_N_N0 <- predict(fit_gompertz, newdata = predicted_curve) } else { predicted_curve$ln_N_N0 <- NA }
grafico_gompertz_nuevo <- ggplot(datos_procesados, aes(x = dia, y = ln_N_N0)) +
  geom_rect(data = fases, aes(xmin = xmin, xmax = xmax, ymin = -Inf, ymax = Inf, fill = fase), alpha = 0.15, inherit.aes = FALSE) +
  geom_line(data = predicted_curve, aes(x = dia, y = ln_N_N0), color = "#FF6B6B", linewidth = 1.5, na.rm = TRUE) +
  geom_point(color = "#4ECDC4", size = 3.5, shape = 21, fill = "white", stroke = 1.5) +
  
  scale_x_continuous(breaks = scales::pretty_breaks(), expand = expansion(mult = c(0, 0.05))) +
  scale_y_continuous(expand = expansion(mult = c(0, 0.05)), limits = c(0, NA)) +
  scale_fill_manual(name = "Fases de Crecimiento", values = setNames(fases$color, fases$fase)) +
  labs(title = "Ajuste al Modelo de Gompertz", subtitle = "Puntos: Datos Observados | Línea: Modelo Ajustado", x = "Tiempo (días)", y = "Crecimiento relativo (ln(N/N₀))") +
  theme_minimal(base_size = 12) +
  theme(
    text = element_text(family = "sans"),
    plot.title = element_text(face = "bold", hjust = 0.5, size = 16, margin = margin(b=5)),
    plot.subtitle = element_text(hjust = 0.5, size=10),
    panel.grid.minor = element_blank(),
    axis.title = element_text(face = "bold", size = 12),
    axis.ticks = element_line(linewidth = 0.4),
    legend.position = "right", legend.title = element_text(face="bold"),
    plot.margin = margin(15, 15, 15, 15),
    axis.line.x.bottom = element_line(colour = "black", linewidth = 0.7),
    axis.line.y.left = element_line(colour = "black", linewidth = 0.7)
  )

params <- if(!is.null(fit_gompertz)) coef(fit_gompertz) else NULL

