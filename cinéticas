# PASO 3: PROCESAMIENTO Y ANÁLISIS AUTOMÁTICO
# ------------------------------------------------------------------------------
datos_activos <- filter(datos_ingresados, if_any(starts_with("abs_rep"), ~ !is.na(.)))
ultimo_dia_con_datos <- max(datos_activos$dia, na.rm = TRUE)

fases <- data.frame(
  fase = factor(c("Latencia", "Exponencial", "Estacionaria"), levels = c("Latencia", "Exponencial", "Estacionaria")),
  xmin = c(0, dia_fin_latencia, dia_fin_exponencial),
  xmax = c(dia_fin_latencia, dia_fin_exponencial, ultimo_dia_con_datos),
  color = c("#9400d3", "#00bfff", "#cd5c5c")
)

datos_brutos <- datos_activos %>%
  pivot_longer(cols = -dia, names_to = c(".value", "replica"), names_pattern = "(.+)_rep(.)") %>%
  filter(!is.na(abs) & !is.na(no_celulas))

datos_procesados <- datos_brutos %>%
  group_by(dia) %>%
  summarise(
    celulas_media = mean(no_celulas, na.rm = TRUE),
    celulas_sd = sd(no_celulas, na.rm = TRUE),
    .groups = "drop"
  ) %>%
  mutate(
    ln_N_N0 = log(celulas_media / first(celulas_media)),
    sd_superior = celulas_media + celulas_sd,
    sd_inferior = pmax(0, celulas_media - celulas_sd)
  )

